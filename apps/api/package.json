{
  "name": "@mogul/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=../../.env --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "test:integration": "pnpm build && node --env-file=../../.env --test dist/test/*.integration.js",
    "seed": "node --env-file=../../.env dist/src/seed.js",
    "contracts": "node --env-file=../../.env dist/src/export-openapi.js"
  },
  "dependencies": {
    "@mogul/contracts": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.3.0",
    "mongodb": "7.7.0",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.4.1",
    "supertest": "7.3.1"
  }
}
